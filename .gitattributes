# Auto-detect text files and normalize line endings in the repo
* text=auto

# Source & config are text
*.cpp   text diff=cpp
*.h     text diff=cpp
*.cs    text
*.ini   text
*.uproject text eol=lf
*.uplugin  text eol=lf
*.md    text

# ---- Git LFS: Unreal binary assets ----
*.uasset  filter=lfs diff=lfs merge=binary -text
*.umap    filter=lfs diff=lfs merge=binary -text

# Textures / images
*.png  filter=lfs diff=lfs merge=binary -text
*.jpg  filter=lfs diff=lfs merge=binary -text
*.jpeg filter=lfs diff=lfs merge=binary -text
*.tga  filter=lfs diff=lfs merge=binary -text
*.bmp  filter=lfs diff=lfs merge=binary -text
*.psd  filter=lfs diff=lfs merge=binary -text
*.exr  filter=lfs diff=lfs merge=binary -text
*.hdr  filter=lfs diff=lfs merge=binary -text
*.tif  filter=lfs diff=lfs merge=binary -text
*.tiff filter=lfs diff=lfs merge=binary -text

# Audio
*.wav  filter=lfs diff=lfs merge=binary -text
*.mp3  filter=lfs diff=lfs merge=binary -text
*.ogg  filter=lfs diff=lfs merge=binary -text

# Video
*.mp4  filter=lfs diff=lfs merge=binary -text
*.mov  filter=lfs diff=lfs merge=binary -text
*.avi  filter=lfs diff=lfs merge=binary -text

# 3D source assets
*.fbx  filter=lfs diff=lfs merge=binary -text
*.obj  filter=lfs diff=lfs merge=binary -text
*.blend filter=lfs diff=lfs merge=binary -text
*.3ds  filter=lfs diff=lfs merge=binary -text
*.abc  filter=lfs diff=lfs merge=binary -text
*.glb  filter=lfs diff=lfs merge=binary -text
*.gltf filter=lfs diff=lfs merge=binary -text

# Fonts & misc binaries
*.ttf  filter=lfs diff=lfs merge=binary -text
*.otf  filter=lfs diff=lfs merge=binary -text
*.ufont filter=lfs diff=lfs merge=binary -text
*.zip  filter=lfs diff=lfs merge=binary -text
*.7z   filter=lfs diff=lfs merge=binary -text
*.icu  filter=lfs diff=lfs merge=binary -text
*.res  filter=lfs diff=lfs merge=binary -text
*.bin  filter=lfs diff=lfs merge=binary -text

# ---- 기획 데이터 ----
# 엑셀은 바이너리라 맨 위 text=auto 로 줄끝 변환 들어가면 파일이 깨짐
*.xlsx binary
*.xlsm binary

# csv 는 일부러 텍스트로 둠 -> git diff 로 기획이 뭘 바꿨는지 줄 단위로 보려고
