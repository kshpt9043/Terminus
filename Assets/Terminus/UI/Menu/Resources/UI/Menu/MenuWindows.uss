/*
 * 메인 메뉴 창 (언리얼 WBP_Base / WBP_Storage / WBP_SaveList / WBP_SaveEntry / WBP_Settlement, JSY 디자인)
 * 버튼은 공용 .tc-flat--card (C++ MakeFlatButtonStyle = WBP 판 0.019382,0.023153,0.031896 + 1px 0.042311,..)
 */

/* 거점 카드 (220x320, 이름은 아래쪽). 글자 자리는 C# 이 절대 위치로
 * 공용 .tc-flat 시트가 버튼 자신에 붙어 있어 같은 특이도면 그쪽이 이김 -> 두 클래스로 */
.tc-flat.tm-bigcard { padding: 0; white-space: normal; }
.tc-flat.tm-bigcard:active { padding: 0; }

/* 창고 첫 화면 카드 (WBP RelicTabButton: 호버 테두리 0.391572,.. = 어두운 금, 눌림 테두리 금, 안쪽 20) */
.tc-flat.tm-hubcard { padding: 20px; white-space: normal; }
.tc-flat.tm-hubcard:hover { background-color: var(--t-disabled); border-color: var(--t-gold-pressed); }
.tc-flat.tm-hubcard:active { background-color: var(--t-section); border-color: var(--t-gold); padding: 20px; }
